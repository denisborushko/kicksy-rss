# ── Telegram ──────────────────────────────────────────────────────────────────
TG_CHANNEL=kicksy_poizon

# ── VKontakte ─────────────────────────────────────────────────────────────────
# Токен пользователя (для загрузки фото/видео)
VK_TOKEN=vk1.a.XXXXXXXXXXXX
# Токен группы (для wall.post)
VK_GROUP_TOKEN=vk1.a.XXXXXXXXXXXX
# ID группы (без минуса)
VK_GROUP_ID=123456789

# ── YouTube ───────────────────────────────────────────────────────────────────
# Путь к файлу client_secrets.json (по умолчанию в корне проекта)
YT_CLIENT_SECRETS=client_secrets.json
# Путь к файлу с OAuth токеном
YT_TOKEN_FILE=youtube_token.json

# ── Интервалы проверки (секунды) ──────────────────────────────────────────────
VK_CHECK_EVERY=3600
YT_CHECK_EVERY=300
